{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "zdev-notify claude alive --json", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "zdev-notify claude working --json", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "zdev-notify claude working --json", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          { "type": "command", "command": "zdev-notify claude needs-permission --json", "timeout": 5 }
        ]
      },
      {
        "hooks": [
          { "type": "command", "command": "zdev-notify claude waiting --json", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "zdev-notify claude done --json", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "zdev-notify claude session-end --json", "timeout": 5 }
        ]
      }
    ]
  }
}
